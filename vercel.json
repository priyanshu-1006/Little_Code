{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run website:build",
  "outputDirectory": "website/dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/reviews", "destination": "/reviews/index.html" },
    { "source": "/docs/:slug(getting-started|installation|first-conversation|modes-and-tools|file-tools|frameworks|language-runner|flutter|memory-mcp|troubleshooting|keyboard-shortcuts)", "destination": "/docs/:slug/index.html" }
  ],
  "functions": {
    "api/reviews.mjs": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/release.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
